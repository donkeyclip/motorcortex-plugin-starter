{
  "name": "my-plugin-name",
  "version": "0.0.1",
  "description": "Your plugin description here",
  "main": "dist/bundle.cjs.js",
  "module": "dist/bundle.esm.js",
  "browser": "dist/bundle.umd.js",
  "type": "module",
  "author": "",
  "repository": {
    "type": "git",
    "url": "Your git repo here"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "rollup -c",
    "start": "npm run build:lib && concurrently -c \"cyan.bold,magenta.bold\" \"npm:build:lib -- -w\"  \"npm:start:demo\" ",
    "start:demo": "webpack serve --mode=development --config ./demo/webpack.config.cjs",
    "build:demo": "webpack --mode=production --config ./demo/webpack.config.cjs",
    "test": "HERE GOES YOUR TEST TASK",
    "test:prod": "npm run lint",
    "prepare": "husky"
  },
  "keywords": [
    "motorcortex"
  ],
  "lint-staged": {
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "peerDependencies": {
    "@donkeyclip/motorcortex": ">=9.24 <10"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.0",
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.29.0",
    "@babel/plugin-syntax-import-assertions": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.29.0",
    "@donkeyclip/motorcortex": "^9.25.0",
    "@donkeyclip/motorcortex-player": "2.17.0",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "babel-loader": "10.1.1",
    "concurrently": "^10.0.5",
    "core-js": "^3.50.0",
    "css-loader": "7.1.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "rollup": "4.63.1",
    "webpack": "^5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "6.0.0"
  }
}
